# Required: powers the default model, image generation, TTS and speech-to-text.
OPENAI_API_KEY=sk-proj-...

# Optional: each one adds models to the picker and to the Arena tab.
# Free tier, no card required: https://aistudio.google.com/api-keys
GOOGLE_API_KEY=
# Free tier, no card required: https://console.groq.com/keys
GROQ_API_KEY=

# Optional: local models via Ollama. Auto-detected, hidden when unreachable.
OLLAMA_BASE_URL=http://localhost:11434

# Optional overrides
ARNIE_DB_PATH=arnie.db
ARNIE_TTS_VOICE=onyx
